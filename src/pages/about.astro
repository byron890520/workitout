---
import Base from "../layouts/Base.astro";
import { CONFIG } from "../lib/site.js";
const email = CONFIG.contact_email;
---
<Base title={`About ${CONFIG.brand}`} description={`About ${CONFIG.brand}: free, accurate calculators built for South Africans.`}
  h1={`About ${CONFIG.brand}`} trail={[["Home", "/"], ["About", "/about/"]]} glyph={null}>
  <p>{CONFIG.brand} makes free, simple tools for everyday South African questions: what will I take home after tax, how many electricity units will I get, what's my APS score?</p>
  <p>We check every calculator against official sources such as SARS, Eskom and university admission guides, and we update the rates when the Budget or tariffs change. Each page shows the date it was last checked.</p>
  <p>Found a mistake? Please tell us at <a href={`mailto:${email}`}>{email}</a>.</p>
</Base>
