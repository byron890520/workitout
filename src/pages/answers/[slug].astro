---
import Base from "../../layouts/Base.astro";
import Related from "../../components/Related.astro";
import { ANSWERS } from "../../lib/answers.js";
import { BASE, TOOLS, CONFIG, updatedFor } from "../../lib/site.js";

export function getStaticPaths() {
  return ANSWERS.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const tool = TOOLS.find((t) => t.slug === a.tool);
const today = updatedFor(`/answers/${a.slug}/`);
const strip = (h) => h.replace(/<[^>]+>/g, "");
---
<Base title={a.title} description={a.desc} h1={a.q}
  trail={[["Home", "/"], ["Answers", "/answers/"], [a.q, `/answers/${a.slug}/`]]} updated
  schema={{ "@type": "Article", headline: a.q, description: strip(a.desc), url: `${BASE}/answers/${a.slug}/`, inLanguage: "en-ZA",
    dateModified: today, author: { "@type": "Organization", name: CONFIG.brand, url: BASE + "/" },
    publisher: { "@type": "Organization", name: CONFIG.brand, url: BASE + "/" } }}>
  <p class="answer-short" set:html={a.short} />
  <a class="answer-cta" href={`/${tool.slug}/`}>
    <span class="key alt" aria-hidden="true">{tool.glyph}</span>
    <span><strong>Work out your own figures</strong><br />{tool.title}: {tool.desc}</span>
  </a>
  {a.sections.map((s) => (<><h2>{s.h}</h2><Fragment set:html={s.html} /></>))}
  <p class="hint">Figures are estimates for the 2026/27 tax year (1 March 2026 – 28 February 2027) and aren't tax advice. Your payroll or SARS assessment may differ.</p>
  <Related exclude={a.tool} answersFor={a.tool} current={a.slug} />
</Base>
