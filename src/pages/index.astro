---
import Base from "../layouts/Base.astro";
import Keypad from "../components/Keypad.astro";
import TileBoard from "../components/TileBoard.astro";
import Intro from "../components/Intro.astro";
import { CONFIG, BASE, TOOLS, DEMO } from "../lib/site.js";

const items = TOOLS.map((t) => ({ href: `/${t.slug}/`, ...t }));
---
<Base title={`${CONFIG.brand} – Free South African Calculators & Daily Word Hints`}
  description="Free South African calculators for salary after tax, VAT, compound interest, prepaid electricity and bond transfer duty, plus daily Wordle and Wortel hints."
  h1="Free South African calculators"
  schema={{ "@type": "WebSite", name: CONFIG.brand, url: BASE + "/", inLanguage: "en-ZA",
    publisher: { "@type": "Organization", name: CONFIG.brand, url: BASE + "/" } }}>
  <Intro slot="intro" />
  <section slot="hero" class="hero paper-band"><div class="wrap">
    <div>
      <h1>South African calculators and daily word hints</h1>
      <p class="lede">Salary after tax, VAT, compound interest, electricity units and bond transfer duty, using this year's SARS and Eskom figures. Plus a gentle nudge for today's Wordle.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/salary-calculator/">Work out my take-home pay</a>
        <a class="btn btn-ghost" href="/word-hints/">Get today's word hint</a>
      </div>
    </div>
    <TileBoard />
  </div></section>

  <section class="pick" data-reveal aria-labelledby="pick-h">
    <h2 id="pick-h"><span>Pick a calculator</span></h2>
    <div class="pick-load" aria-hidden="true"><i></i><i></i><i></i></div>
    <Keypad items={items} />
  </section>
  {DEMO && <div class="ad-slot" aria-hidden="true">Ad space</div>}
  <h2>Built for South Africa</h2>
  <p>Most online calculators are made for the US or UK. Ours use South African rules: SARS tax tables, 15% VAT, rand-based savings growth, Eskom and municipal electricity tariffs, and SARS transfer duty. Each tool shows the formula and the official rates it uses, so you can check the working yourself.</p>
  <p>Everything is free, works on your phone, and doesn't ask you to sign up. Every result has a share link, so you can send your sums to a partner, a parent or your accountant.</p>
</Base>
