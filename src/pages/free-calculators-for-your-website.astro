---
import Base from "../layouts/Base.astro";
import { TOOLS, BASE, todaySA } from "../lib/site.js";
import { EMBEDDABLE, snippet } from "../lib/embed.js";
const tools = EMBEDDABLE.map((s) => TOOLS.find((t) => t.slug === s));
const faqs = [
  ["Is it really free?", "Yes. There's no sign-up, no fee and no ads inside the calculator. We only ask that you keep the small credit link under it."],
  ["Will the calculator stay up to date?", "Yes. It loads from our site, so when SARS rates change after the Budget, the calculator on your page updates automatically."],
  ["Does it work on WordPress, Wix and Squarespace?", "Yes. Paste the code into a Custom HTML block (WordPress), an Embed / HTML element (Wix) or a Code block (Squarespace)."],
];
---
<Base title="Free Calculators for Your Website – SA Tax, Salary & VAT Widgets"
  description="Add a free South African salary, tax refund, VAT, transfer duty or compound interest calculator to your website. Copy one line of code. Always up to date with SARS rates."
  h1="Free calculators for your website" lede="Give your visitors a South African tax, salary or property calculator. Copy, paste, done."
  trail={[["Home", "/"], ["Calculators for your website", "/free-calculators-for-your-website/"]]} faqs={faqs} updated={todaySA()}
  schema={{ "@type": "WebPage", name: "Free calculators for your website", url: BASE + "/free-calculators-for-your-website/" }}>
  <p>Accountants, estate agents, bookkeepers, HR teams, bloggers and financial advisers use calculators to help their readers. Ours are free to put on your own site. They fit any width, work on phones, and update automatically when SARS changes the rates.</p>
  <h2>How to add one</h2>
  <ol>
    <li>Pick a calculator below and press <strong>Copy code</strong>.</li>
    <li>Paste it into your page as HTML (a Custom HTML block in WordPress, an Embed element in Wix).</li>
    <li>Publish. The calculator resizes itself to fit.</li>
  </ol>
  <h2>Choose a calculator</h2>
  <div class="embed-list">
    {tools.map((t) => (
      <section class="embed-item">
        <div class="embed-head">
          <span class={`key ${t.alt ? "alt" : ""}`} aria-hidden="true">{t.glyph}</span>
          <div><h3>{t.title}</h3><p>{t.desc}</p></div>
        </div>
        <textarea readonly rows="4" aria-label={`Embed code for the ${t.title}`}>{snippet(t.slug)}</textarea>
        <div class="embed-actions">
          <button type="button" class="btn btn-primary" data-copy>Copy code</button>
          <a class="btn btn-ghost" href={`/embed/${t.slug}/`} target="_blank" rel="noopener">Preview</a>
          <span class="share-msg" role="status" aria-live="polite"></span>
        </div>
      </section>
    ))}
  </div>
  <script is:inline>
  document.querySelectorAll("[data-copy]").forEach(function (b) {
    b.addEventListener("click", function () {
      var box = b.closest(".embed-item"), ta = box.querySelector("textarea"), msg = box.querySelector(".share-msg");
      var done = function () { msg.textContent = "Copied"; setTimeout(function () { msg.textContent = ""; }, 2500); };
      if (navigator.clipboard) navigator.clipboard.writeText(ta.value).then(done, function () { ta.select(); msg.textContent = "Press Ctrl+C to copy"; });
      else { ta.select(); msg.textContent = "Press Ctrl+C to copy"; }
    });
  });
  </script>
</Base>
