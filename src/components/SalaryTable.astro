---
// Take-home pay at every common salary, each linking to its own worked answer page.
import { salary, money } from "../lib/calc.js";
import { salaryAmounts, salarySlug } from "../lib/answers.js";
const { open = false } = Astro.props;
const nb = (x) => x.replace(/ /g, "\u00a0");
const rows = salaryAmounts.map((a) => ({ a, s: salary({ monthlyGross: a }) }));
const eg = salary({ monthlyGross: 25000 });
---
<details class="salary-table" open={open}>
  <summary><span>R25 000 a month: <strong>{nb(money(eg.net))}</strong> take-home</span><span class="more">More salaries</span></summary>
  <div class="table-scroll"><table>
    <thead><tr><th>Salary</th><th>PAYE</th><th>Take-home</th></tr></thead>
    <tbody>{rows.map(({ a, s }) => (
      <tr><td><a href={`/answers/${salarySlug(a)}/`}>{money(a)}</a></td><td>{money(s.paye)}</td><td>{money(s.net)}</td></tr>
    ))}</tbody>
  </table></div>
  <p class="hint">Per month, after PAYE and 1% UIF. Under 65, no medical aid or pension deductions. Tap a salary for the full working.</p>
</details>
