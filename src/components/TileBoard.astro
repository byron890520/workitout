---
// The home page's 3D board: letter tiles flip into place, then the board leans towards the pointer.
// Plain JavaScript (no React), so the home page doesn't need to load React.
const ROWS = ["WORK", "IT+%", "OUT="];
const tiles = ROWS.flatMap((row) => [...row]);
---
<div class="board-stage" aria-hidden="true">
  <div class="board float">
    {tiles.map((ch, k) => (
      <div class={"tile" + ("+%=".includes(ch) ? " op" : "")} style={`--i:${k}`}>
        <div class="inner"><span class="face front">{ch}</span><span class="face back">{ch}</span></div>
      </div>
    ))}
  </div>
</div>

<script>
  const el = document.querySelector<HTMLElement>(".board");
  if (el && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const stage = el.parentElement!;
    let raf = 0;
    const apply = (x: number, y: number) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        el.style.setProperty("--rx", `${18 - y * 14}deg`);
        el.style.setProperty("--ry", `${-20 + x * 26}deg`);
      });
    };
    addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const r = stage.getBoundingClientRect();
      apply((e.clientX - r.left) / r.width - 0.5, (e.clientY - r.top) / r.height - 0.5);
    }, { passive: true });
    addEventListener("scroll", () => {
      const r = stage.getBoundingClientRect();
      apply(0, Math.max(-0.6, Math.min(0.6, (r.top + r.height / 2) / innerHeight - 0.5)));
    }, { passive: true });
    // Tap a tile to flip it again.
    el.addEventListener("click", (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>(".tile");
      if (!t) return;
      t.classList.remove("again");
      void t.offsetWidth;
      t.classList.add("again");
    });
  }
</script>
